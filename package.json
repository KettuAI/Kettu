{
  "name": "overbench",
  "productName": "OverBench",
  "version": "0.0.0",
  "private": true,
  "description": "A beautifully crafted desktop workbench for terminal coding agents.",
  "author": "Amigoer",
  "license": "Apache-2.0",
  "homepage": "https://github.com/overbench/overbench",
  "repository": {
    "type": "git",
    "url": "https://github.com/overbench/overbench.git"
  },
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "pnpm typecheck && electron-vite build",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web && pnpm typecheck:tools",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "lint": "eslint --cache . && node tools/lint/css-colors.mjs && node tools/lint/contrast.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "pnpm build && electron-builder --dir",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:linux": "pnpm build && electron-builder --linux",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "6.8.9",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "2.0.0",
    "@base-ui/react": "^1.9.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@dnd-kit/react": "^0.5.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@lezer/markdown": "1.8.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@pierre/diffs": "1.6.0",
    "@shadcn/react": "^0.3.1",
    "@streamdown/cjk": "1.0.4",
    "@streamdown/code": "2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uiw/codemirror-theme-github": "4.25.12",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "codemirror": "6.0.2",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "i18next": "26.5.4",
    "lucide-react": "^1.60.0",
    "material-icon-theme": "5.39.0",
    "motion": "^14.4.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.1",
    "react-i18next": "17.1.0",
    "react-resizable-panels": "^4.14.7",
    "remark-breaks": "4.0.0",
    "shadcn": "^4.22.1",
    "shiki": "4.5.0",
    "streamdown": "2.7.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "5.0.5",
    "zustand": "^5.0.15"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "electron-winstaller"
    ],
    "onlyBuiltDependencies": [
      "node-pty"
    ],
    "patchedDependencies": {
      "@pierre/theming@1.0.1": "patches/@pierre__theming@1.0.1.patch"
    }
  }
}
