{
  "compilerOptions": {
    "composite": true,
    "target": "ES2025",
    "lib": ["ES2025"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["node", "electron-vite/node"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "tools/build/third-party-notices.ts",
    "vitest.config.mts",
    "vite.daemon.config.mts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/agent-host/**/*",
    "src/terminal-host/**/*",
    "src/remote-host/**/*",
    "src/daemon/**/*"
  ]
}
