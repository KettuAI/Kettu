{
  "minRatio": 4.5,
  "exempt": ["--text-disabled"],
  "groups": [
    {
      "fg": "--text-primary",
      "on": [
        "--bg-app",
        "--bg-sidebar",
        "--bg-surface",
        "--bg-subtle",
        "--bg-code-inline",
        "--bg-code-block",
        "--bg-hover",
        "--bg-selected",
        "--bg-raised",
        "--danger-tint",
        "--success-tint",
        "--info-tint",
        "--warning-tint"
      ]
    },
    {
      "fg": "--text-secondary",
      "on": [
        "--bg-app",
        "--bg-sidebar",
        "--bg-surface",
        "--bg-subtle",
        "--bg-code-block",
        "--bg-hover",
        "--bg-selected",
        "--bg-raised"
      ]
    },
    {
      "fg": "--text-tertiary",
      "on": [
        "--bg-app",
        "--bg-sidebar",
        "--bg-surface",
        "--bg-subtle",
        "--bg-code-block",
        "--bg-hover",
        "--bg-raised"
      ]
    },
    { "fg": "--text-placeholder", "on": ["--bg-surface", "--bg-app", "--bg-sidebar"] },
    { "fg": "--attention", "on": ["--bg-app", "--bg-sidebar", "--bg-surface"] },
    { "fg": "--code-inline", "on": ["--bg-code-inline"] },
    {
      "fg": "--danger",
      "on": [
        "--bg-app",
        "--bg-sidebar",
        "--bg-surface",
        "--bg-subtle",
        "--bg-code-block",
        "--bg-hover",
        "--danger-tint"
      ]
    },
    {
      "fg": "--success",
      "on": ["--bg-app", "--bg-sidebar", "--bg-surface", "--bg-code-block", "--success-tint"]
    },
    {
      "fg": "--info",
      "on": ["--bg-app", "--bg-sidebar", "--bg-surface", "--info-tint", "--info-tint-hover"]
    },
    {
      "fg": "--merged",
      "on": [
        "--bg-app",
        "--bg-sidebar",
        "--bg-surface",
        "--bg-subtle",
        "--bg-hover",
        "--bg-selected"
      ]
    },
    { "fg": "--warning", "on": ["--bg-app", "--bg-sidebar", "--bg-surface", "--warning-tint"] },
    { "fg": "--link", "on": ["--bg-app", "--bg-surface", "--bg-subtle"] },
    { "fg": "--link-hover", "on": ["--bg-app", "--bg-surface", "--bg-subtle"] },
    { "fg": "--switch-on", "on": ["--bg-app", "--bg-sidebar", "--bg-surface"], "minRatio": 3 },
    { "fg": "--control-on", "on": ["--bg-app", "--bg-sidebar", "--bg-surface"], "minRatio": 3 },
    { "fg": "--send", "on": ["--bg-surface"], "minRatio": 3 },
    { "fg": "--on-fill", "on": ["--send"], "minRatio": 3 },
    { "fg": "--syntax-keyword", "on": ["--bg-code-block", "--bg-app"] },
    { "fg": "--syntax-string", "on": ["--bg-code-block", "--bg-app"] },
    { "fg": "--syntax-number", "on": ["--bg-code-block", "--bg-app"] },
    { "fg": "--syntax-function", "on": ["--bg-code-block", "--bg-app"] },
    { "fg": "--syntax-type", "on": ["--bg-code-block", "--bg-app"] },
    { "fg": "--code-success", "on": ["--bg-code-block", "--bg-app"] },
    { "fg": "--code-danger", "on": ["--bg-code-block", "--bg-app"] },
    { "fg": "--bg-surface", "on": ["--text-primary", "--attention"] },
    { "fg": "--primary-foreground", "on": ["--primary-from", "--primary-hover-from"] },
    { "fg": "--bg-app", "on": ["--text-primary"] },
    { "fg": "--toast-foreground", "on": ["--toast"] }
  ]
}
