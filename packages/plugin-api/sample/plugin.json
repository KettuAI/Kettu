{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "session-digest",
  "version": "1.0.0",
  "description": "Counts the sessions that work and can post the count to a webhook.",
  "extensions": {
    "sh.kettu": {
      "format": 1,
      "script": "./sh.kettu/main.js",
      "api": 1,
      "permissions": ["sessions.summary", "network:hooks.example.com"]
    }
  }
}
